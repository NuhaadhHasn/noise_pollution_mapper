# Firebase Configuration
# Get these values from Firebase Console -> Project Settings -> General
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here

# Google Maps API Key (if using)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Classification Settings
CONFIDENCE_THRESHOLD=0.6
CLASSIFICATION_INTERVAL_SECONDS=5

# Notification Settings
HIGH_NOISE_THRESHOLD=70

# PayPal Configuration (Sandbox Mode for Testing)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_SECRET=your_paypal_sandbox_secret
PAYPAL_SANDBOX_MODE=true

# Buy Me a Coffee Configuration
BUY_ME_A_COFFEE_URL=https://www.buymeacoffee.com/yourusername
